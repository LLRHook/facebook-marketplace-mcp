{
  "name": "facebook-marketplace-mcp",
  "version": "1.0.0",
  "description": "MCP server for Facebook Marketplace — direct GraphQL API access",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "facebook-marketplace-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "login": "tsx src/facebook/login.ts",
    "test": "npm run build && tsx --test test/*.test.ts && node --test validation/response-handling.test.mjs && node validation/smoke.mjs",
    "test:live": "npm run build && node validation/live-smoke.mjs",
    "test:browser": "npm run build && node validation/browser-smoke.mjs",
    "capture-queries": "tsx scripts/capture-queries.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.63.0",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
